import React, { useState, useEffect, useCallback, useRef } from 'react';
import { useLocation } from 'react-router-dom';
import { useTranslation } from 'react-i18next';
import { useTheme } from '../src/contexts/ThemeContext';
import { api } from '../src/services/api';
import { generateSqlFromNaturalLanguage, explainQueryPlan } from '../services/geminiService';
import { toast } from '../src/hooks/use-toast';
import {
  Play,
  Sparkles,
  Save,
  Trash2,
  Box,
  Wand2,
  Database,
  Gauge,
  Scan,
  Filter,
  Calculator,
  Network,
  RefreshCw,
  ChevronDown,
  ChevronUp,
  X,
  Loader2,
  History,
  Bookmark,
  Copy,
  Table2,
  Code2,
  PanelLeft,
  PanelLeftClose,
  LayoutTemplate,
  Lightbulb,
  Wand
} from 'lucide-react';

// --- Types ---
interface QueryResult {
  columns: string[];
  data: any[];
  rows: number;
}

interface QueryHistory {
  id: string;
  sql: string;
  timestamp: number;
  duration: number;
}

interface SavedQuery {
  id: string;
  name: string;
  sql: string;
  createdAt: number;
}

interface ExplainNode {
  id: number;
  name: string;
  type: 'SCAN' | 'FILTER' | 'AGGREGATE' | 'PROJECT' | 'EXCHANGE';
  cost: number;
  rows: number;
  info: string;
  children?: ExplainNode[];
  warning?: boolean;
}

const SAMPLE_TEMPLATES = [
  { name: 'Last Hour Avg', sql: 'SELECT avg(current) FROM meters WHERE ts > NOW - 1h GROUP BY $interval(5m);' },
  { name: 'Device Status', sql: 'SELECT last(*) FROM meters WHERE device_id = "{{deviceId}}";' },
  { name: 'Top 10 Values', sql: 'SELECT TOP 10 * FROM meters ORDER BY voltage DESC;' },
];

// --- Query Result Table Component ---
interface QueryResultTableProps {
  data: QueryResult;
  isDark: boolean;
  loading?: boolean;
}

const QueryResultTable: React.FC<QueryResultTableProps> = ({ data, isDark, loading }) => {
  const [sortCol, setSortCol] = useState<string | null>(null);
  const [sortDesc, setSortDesc] = useState(false);

  const handleSort = (col: string) => {
    if (sortCol === col) {
      setSortDesc(!sortDesc);
    } else {
      setSortCol(col);
      setSortDesc(false);
    }
  };

  const sortedData = React.useMemo(() => {
    if (!sortCol) return data.data;
    return [...data.data].sort((a, b) => {
      const aVal = a[sortCol];
      const bVal = b[sortCol];
      if (aVal === null || aVal === undefined) return sortDesc ? 1 : -1;
      if (bVal === null || bVal === undefined) return sortDesc ? -1 : 1;
      if (typeof aVal === 'number' && typeof bVal === 'number') {
        return sortDesc ? bVal - aVal : aVal - bVal;
      }
      return sortDesc 
        ? String(bVal).localeCompare(String(aVal))
        : String(aVal).localeCompare(String(bVal));
    });
  }, [data.data, sortCol, sortDesc]);

  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <Loader2 className="w-8 h-8 animate-spin text-blue-500" />
      </div>
    );
  }

  if (!data || data.data.length === 0) {
    return (
      <div className={`flex flex-col items-center justify-center h-64 ${isDark ? 'text-gray-500' : 'text-gray-400'}`}>
        <Table2 className="w-12 h-12 mb-2 opacity-30" />
        <p className="text-sm">No data returned</p>
      </div>
    );
  }

  return (
    <div className="overflow-auto">
      <table className="w-full text-left text-sm">
        <thead className={`sticky top-0 text-xs uppercase ${isDark ? "bg-gray-800 text-gray-400" : "bg-gray-100 text-gray-600"}`}>
          <tr>
            {data.columns.map((col) => (
              <th
                key={col}
                onClick={() => handleSort(col)}
                className="px-4 py-3 font-medium cursor-pointer hover:bg-opacity-80 transition-colors select-none whitespace-nowrap"
              >
                <div className="flex items-center gap-1">
                  {col}
                  {sortCol === col && (
                    sortDesc ? <ChevronDown className="w-3 h-3" /> : <ChevronUp className="w-3 h-3" />
                  )}
                </div>
              </th>
            ))}
          </tr>
        </thead>
        <tbody className={`divide-y ${isDark ? "divide-gray-800" : "divide-gray-200"}`}>
          {sortedData.map((row, index) => (
            <tr key={index} className={`${isDark ? "hover:bg-gray-800/50" : "hover:bg-gray-50"}`}>
              {data.columns.map((col) => (
                <td key={col} className="px-4 py-2 whitespace-nowrap">
                  {row[col] !== null && row[col] !== undefined ? String(row[col]) : '-'}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
};

// --- Main Component ---
export const QueryWorkbench: React.FC = () => {
  const { t } = useTranslation();
  const { resolvedTheme } = useTheme();
  const location = useLocation();
  const isDark = resolvedTheme === 'dark';
  const textareaRef = useRef<HTMLTextAreaElement>(null);

  // Editor state
  const [query, setQuery] = useState(location.state?.sql || 'SELECT avg(voltage) FROM meters \nWHERE $last_24h \nAND device_group = {{groupId}} \nGROUP BY $interval(1h);');
  const [params, setParams] = useState<Record<string, string>>({ groupId: '101' });
  const [detectedParams, setDetectedParams] = useState<string[]>(['groupId']);

  // AI Assistant state
  const [showAiInput, setShowAiInput] = useState(false);
  const [prompt, setPrompt] = useState('');
  const [loadingAi, setLoadingAi] = useState(false);

  // Execution state
  const [executing, setExecuting] = useState(false);
  const [result, setResult] = useState<QueryResult | null>(null);
  const [executionTime, setExecutionTime] = useState(0);
  const [logs, setLogs] = useState<string[]>([t('query.systemReady', 'System ready. TD-SQL+ Syntax enabled.')]);

  // History and Saved Queries state
  const [history, setHistory] = useState<QueryHistory[]>([]);
  const [savedQueries, setSavedQueries] = useState<SavedQuery[]>([]);
  const [showSidebar, setShowSidebar] = useState(false);
  const [activeSidebarTab, setActiveSidebarTab] = useState<'HISTORY' | 'SAVED'>('HISTORY');
  const [saveQueryName, setSaveQueryName] = useState('');
  const [showSaveDialog, setShowSaveDialog] = useState(false);

  // Tabs
  const [activeTab, setActiveTab] = useState<'RESULTS' | 'LOGS' | 'EXPLAIN' | 'MACROS'>('RESULTS');
  const [explainResult, setExplainResult] = useState<ExplainNode | null>(null);
  const [aiExplain, setAiExplain] = useState<string | null>(null);
  const [analyzingPlan, setAnalyzingPlan] = useState(false);

  // Load history and saved queries from localStorage
  useEffect(() => {
    const savedHistory = localStorage.getItem('queryWorkbench_history');
    if (savedHistory) {
      try {
        setHistory(JSON.parse(savedHistory));
      } catch (e) {
        console.error('Failed to parse history:', e);
      }
    }

    const saved = localStorage.getItem('queryWorkbench_saved');
    if (saved) {
      try {
        setSavedQueries(JSON.parse(saved));
      } catch (e) {
        console.error('Failed to parse saved queries:', e);
      }
    }
  }, []);

  // Save history to localStorage
  const saveHistory = useCallback((newHistory: QueryHistory[]) => {
    localStorage.setItem('queryWorkbench_history', JSON.stringify(newHistory));
  }, []);

  const saveQueries = useCallback((queries: SavedQuery[]) => {
    localStorage.setItem('queryWorkbench_saved', JSON.stringify(queries));
  }, []);

  useEffect(() => {
    if (location.state?.sql) {
      setQuery(location.state.sql);
    }
  }, [location.state]);

  useEffect(() => {
    const regex = /\{\{(\w+)\}\}/g;
    const found: string[] = [];
    let match;
    while ((match = regex.exec(query)) !== null) {
      found.push(match[1]);
    }
    setDetectedParams([...new Set(found)]);
  }, [query]);

  const handleAiGenerate = async () => {
    if (!prompt.trim()) return;
    setLoadingAi(true);
    const schemaContext = `SuperTable meters (ts TIMESTAMP, current FLOAT, voltage INT) TAGS (location BINARY, groupId INT)`;
    const generatedSql = await generateSqlFromNaturalLanguage(prompt, schemaContext);
    setQuery(generatedSql);
    setShowAiInput(false);
    setPrompt('');
    setLoadingAi(false);
    toast({
      title: 'AI Generated',
      description: 'SQL query has been generated',
    });
  };

  const handleExecute = async () => {
    if (!query.trim()) {
      toast({
        title: 'Empty Query',
        description: 'Please enter a SQL query',
        variant: 'destructive',
      });
      return;
    }

    setExecuting(true);
    setActiveTab('RESULTS');
    const startTime = Date.now();

    let effectiveQuery = query
      .replace('$last_24h', 'ts >= NOW - 24h')
      .replace(/\$interval\((\w+)\)/g, 'INTERVAL($1) SLIDING($1) FILL(PREV)');

    detectedParams.forEach(p => {
      effectiveQuery = effectiveQuery.replace(new RegExp(`{{${p}}}`, 'g'), params[p] || '?');
    });

    const timestamp = new Date().toLocaleTimeString();
    setLogs(prev => [
      `[${timestamp}] Executing Native SQL: ${effectiveQuery}`,
      `[${timestamp}] ----------------------------------------`,
      ...prev
    ]);

    try {
      const response = await api.tdengine.query(effectiveQuery);
      const duration = Date.now() - startTime;
      setExecutionTime(duration);

      // Check if response has the expected structure
      const responseData = response.data?.data;
      if (responseData && Array.isArray(responseData.rows)) {
        const queryResult: QueryResult = {
          columns: responseData.columns || Object.keys(responseData.rows[0] || {}),
          data: responseData.rows,
          rows: responseData.rows.length,
        };
        setResult(queryResult);

        // Add to history
        const newHistoryItem: QueryHistory = {
          id: Date.now().toString(),
          sql: query,
          timestamp: Date.now(),
          duration,
        };
        const updatedHistory = [newHistoryItem, ...history.slice(0, 49)];
        setHistory(updatedHistory);
        saveHistory(updatedHistory);

        setLogs(prev => [`[${new Date().toLocaleTimeString()}] Query executed successfully (${queryResult.rows} rows, ${(duration / 1000).toFixed(3)}s)`, ...prev]);
      } else {
        setResult({ columns: [], data: [], rows: 0 });
        setLogs(prev => [`[${new Date().toLocaleTimeString()}] Query executed successfully (0 rows)`, ...prev]);
      }
    } catch (error: any) {
      const errorMsg = error.response?.data?.message || error.message || 'Unknown error';
      toast({
        title: 'Execution Error',
        description: errorMsg,
        variant: 'destructive',
      });
      setLogs(prev => [`[${new Date().toLocaleTimeString()}] ERROR: ${errorMsg}`, ...prev]);
    } finally {
      setExecuting(false);
    }
  };

  const handleExplain = () => {
    setActiveTab('EXPLAIN');
    setAiExplain(null);

    const mockPlan: ExplainNode = {
      id: 1, name: 'Project', type: 'PROJECT', cost: 120, rows: 24, info: 'Output: ts, avg(voltage)',
      children: [
        {
          id: 2, name: 'Exchange', type: 'EXCHANGE', cost: 110, rows: 24, info: 'Gather from 4 DNodes',
          children: [
            {
              id: 3, name: 'Aggregate', type: 'AGGREGATE', cost: 100, rows: 24, info: 'Group By: Interval(1h)',
              children: [
                {
                  id: 4, name: 'Filter', type: 'FILTER', cost: 80, rows: 150000, info: 'Filter: device_group = 101',
                  children: [
                    {
                      id: 5, name: 'Table Scan', type: 'SCAN', cost: 60, rows: 5000000, info: 'Table: meters (Full Scan)', warning: true
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    };
    setExplainResult(mockPlan);
  };

  const handleAiPlanAnalysis = async () => {
    if (!explainResult) return;
    setAnalyzingPlan(true);
    try {
      const result = await explainQueryPlan(query, explainResult);
      setAiExplain(result);
    } catch (e) {
      console.error(e);
    } finally {
      setAnalyzingPlan(false);
    }
  };

  const handleKeyDown = (e: React.KeyboardEvent<HTMLTextAreaElement>) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      handleExecute();
    }
  };

  const loadQuery = (sql: string) => {
    setQuery(sql);
    toast({
      title: 'Query Loaded',
      description: 'SQL query has been loaded into editor',
    });
  };

  const handleSaveQuery = () => {
    if (!saveQueryName.trim() || !query.trim()) return;

    const newQuery: SavedQuery = {
      id: Date.now().toString(),
      name: saveQueryName,
      sql: query,
      createdAt: Date.now(),
    };

    const updated = [newQuery, ...savedQueries];
    setSavedQueries(updated);
    saveQueries(updated);
    setShowSaveDialog(false);
    setSaveQueryName('');

    toast({
      title: 'Query Saved',
      description: 'Query has been saved to your collection',
    });
  };

  const deleteFromHistory = (id: string, e: React.MouseEvent) => {
    e.stopPropagation();
    const updated = history.filter(item => item.id !== id);
    setHistory(updated);
    saveHistory(updated);
  };

  const deleteSavedQuery = (id: string, e: React.MouseEvent) => {
    e.stopPropagation();
    const updated = savedQueries.filter(item => item.id !== id);
    setSavedQueries(updated);
    saveQueries(updated);
  };

  const clearQuery = () => {
    setQuery('');
    setResult(null);
  };

  const formatTime = (timestamp: number) => {
    return new Date(timestamp).toLocaleString();
  };

  const copyToClipboard = async () => {
    try {
      await navigator.clipboard.writeText(query);
      toast({
        title: 'Copied',
        description: 'SQL copied to clipboard',
      });
    } catch (err) {
      console.error('Failed to copy:', err);
    }
  };

  const renderExplainNode = (node: ExplainNode, depth = 0) => {
    const getIcon = (type: string) => {
      switch(type) {
        case 'SCAN': return <Scan className="w-4 h-4 text-blue-400"/>;
        case 'FILTER': return <Filter className="w-4 h-4 text-yellow-400"/>;
        case 'AGGREGATE': return <Calculator className="w-4 h-4 text-purple-400"/>;
        case 'EXCHANGE': return <Network className="w-4 h-4 text-gray-400"/>;
        default: return <Box className="w-4 h-4 text-gray-400"/>;
      }
    };

    return (
      <div key={node.id} className="relative">
        <div className={`
          flex items-start p-3 mb-2 rounded border transition-all
          ${node.warning ? 'bg-red-900/20 border-red-500/50' : 'bg-gray-800/50 border-gray-700'}
        `} style={{ marginLeft: `${depth * 20}px` }}>
          <div className={`mt-0.5 mr-3 p-1.5 rounded ${node.warning ? 'bg-red-500/20' : 'bg-gray-800'}`}>
            {getIcon(node.type)}
          </div>
          <div className="flex-1">
            <div className="flex justify-between items-center mb-1">
              <span className={`font-bold text-sm ${node.warning ? 'text-red-400' : 'text-gray-200'}`}>
                {node.name}
                {node.warning && <span className="ml-2 text-[10px] bg-red-500 text-white px-1.5 py-0.5 rounded">SLOW</span>}
              </span>
              <span className="text-xs text-gray-500 font-mono">Cost: {node.cost}</span>
            </div>
            <p className="text-xs text-gray-400">{node.info}</p>
            <p className="text-[10px] text-gray-500 mt-1">Rows: {node.rows.toLocaleString()}</p>
          </div>
        </div>
        {node.children && node.children.map(child => renderExplainNode(child, depth + 1))}
      </div>
    );
  };

  return (
    <div className="min-h-[calc(100vh-6rem)] flex flex-col gap-4 p-4 bg-gray-900">
      {/* Header Row */}
      <div className="flex justify-between items-center flex-shrink-0">
        <div className="flex items-center gap-3">
          <h1 className="text-2xl font-bold text-gray-100">
            SQL Workbench
          </h1>
          <span className="text-xs bg-blue-900/30 text-blue-400 border border-blue-500/30 px-2 py-0.5 rounded flex items-center">
            <Wand2 className="w-3 h-3 mr-1" /> TD-SQL+ Enabled
          </span>
        </div>
        <div className="flex items-center gap-2">
          {/* AI Button */}
          <button
            onClick={() => setShowAiInput(!showAiInput)}
            className="group relative flex items-center gap-2 px-3 py-1.5 text-sm bg-gradient-to-r from-purple-900/40 to-blue-900/40 border border-purple-500/30 rounded-lg hover:from-purple-900/60 hover:to-blue-900/60 transition-all"
            title="Click to generate SQL with AI"
          >
            <Wand className="w-4 h-4 text-purple-400" />
            <span className="text-purple-300">AI Generate SQL</span>
            {/* Tooltip */}
            <span className="absolute right-full mr-2 px-2 py-1 bg-gray-800 text-gray-200 text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none z-10 border border-gray-700">
              Describe what you want in natural language
            </span>
          </button>
          
          {/* Save Button */}
          <button
            onClick={() => setShowSaveDialog(true)}
            className="flex items-center gap-2 px-3 py-1.5 text-sm bg-gray-800 hover:bg-gray-700 border border-gray-700 text-gray-300 rounded-lg transition"
          >
            <Save className="w-4 h-4" /> Save
          </button>
          
          {/* Sidebar Toggle */}
          <button
            onClick={() => setShowSidebar(!showSidebar)}
            className={`flex items-center gap-2 px-3 py-1.5 text-sm rounded-lg transition ${
              showSidebar
                ? "bg-blue-900/50 text-blue-300 border border-blue-500/30"
                : "bg-gray-800 hover:bg-gray-700 text-gray-300 border border-gray-700"
            }`}
          >
            {showSidebar ? <PanelLeftClose className="w-4 h-4" /> : <PanelLeft className="w-4 h-4" />}
            {showSidebar ? 'Hide' : 'History'}
          </button>
        </div>
      </div>

      {/* AI Input Panel */}
      {showAiInput && (
        <div className="bg-gradient-to-r from-purple-900/20 to-blue-900/20 border border-purple-500/30 rounded-lg p-3 flex gap-3 items-center">
          <input
            type="text"
            value={prompt}
            onChange={(e) => setPrompt(e.target.value)}
            placeholder="Describe what you want (e.g., 'Find average voltage for group 5 in the last hour')"
            className="flex-1 bg-gray-900/50 border border-gray-700 rounded px-3 py-2 text-gray-200 focus:outline-none focus:border-purple-500 text-sm"
            onKeyDown={(e) => {
              if (e.key === 'Enter') {
                handleAiGenerate();
              }
            }}
          />
          <button
            onClick={handleAiGenerate}
            disabled={loadingAi || !prompt.trim()}
            className="px-4 py-2 bg-purple-600 hover:bg-purple-500 disabled:bg-purple-800 text-white rounded-md text-sm font-medium transition-colors flex items-center gap-1"
          >
            {loadingAi ? <Loader2 className="w-3 h-3 animate-spin" /> : <Sparkles className="w-3 h-3" />}
            Generate
          </button>
          <button
            onClick={() => setShowAiInput(false)}
            className="p-2 text-gray-400 hover:text-gray-200"
          >
            <X className="w-4 h-4" />
          </button>
        </div>
      )}

      {/* Main Content Area */}
      <div className="flex-1 flex gap-4 min-h-0">
        {/* Sidebar - Query History & Saved */}
        {showSidebar && (
          <div className="w-64 flex-shrink-0 flex flex-col border rounded-lg overflow-hidden bg-gray-800 border-gray-700">
            <div className="flex border-b border-gray-700">
              <button
                onClick={() => setActiveSidebarTab('HISTORY')}
                className={`flex-1 py-2 text-xs font-medium flex items-center justify-center gap-1 transition-colors ${
                  activeSidebarTab === 'HISTORY'
                    ? "bg-gray-700 text-blue-400"
                    : "text-gray-400 hover:text-gray-300"
                }`}
              >
                <History className="w-3 h-3" />
                History
              </button>
              <button
                onClick={() => setActiveSidebarTab('SAVED')}
                className={`flex-1 py-2 text-xs font-medium flex items-center justify-center gap-1 transition-colors ${
                  activeSidebarTab === 'SAVED'
                    ? "bg-gray-700 text-blue-400"
                    : "text-gray-400 hover:text-gray-300"
                }`}
              >
                <Bookmark className="w-3 h-3" />
                Saved
              </button>
            </div>

            <div className="flex-1 overflow-auto p-2">
              {activeSidebarTab === 'HISTORY' && (
                <div className="space-y-1">
                  {history.length === 0 ? (
                    <div className="text-xs text-center py-4 text-gray-500">
                      No query history yet
                    </div>
                  ) : (
                    history.map((item) => (
                      <div
                        key={item.id}
                        onClick={() => loadQuery(item.sql)}
                        className="group p-2 rounded cursor-pointer text-xs hover:bg-gray-700"
                      >
                        <div className="flex justify-between items-start mb-1">
                          <code className="truncate flex-1 font-mono text-blue-400">
                            {item.sql.substring(0, 35)}{item.sql.length > 35 ? '...' : ''}
                          </code>
                          <button
                            onClick={(e) => deleteFromHistory(item.id, e)}
                            className="opacity-0 group-hover:opacity-100 p-1 hover:text-red-500 transition-opacity"
                          >
                            <X className="w-3 h-3" />
                          </button>
                        </div>
                        <div className="flex justify-between text-[10px] text-gray-500">
                          <span>{formatTime(item.timestamp)}</span>
                          <span>{(item.duration / 1000).toFixed(2)}s</span>
                        </div>
                      </div>
                    ))
                  )}
                </div>
              )}

              {activeSidebarTab === 'SAVED' && (
                <div className="space-y-1">
                  {savedQueries.length === 0 ? (
                    <div className="text-xs text-center py-4 text-gray-500">
                      No saved queries yet
                    </div>
                  ) : (
                    savedQueries.map((item) => (
                      <div
                        key={item.id}
                        onClick={() => loadQuery(item.sql)}
                        className="group p-2 rounded cursor-pointer text-xs hover:bg-gray-700"
                      >
                        <div className="flex justify-between items-start mb-1">
                          <span className="font-medium text-gray-200">
                            {item.name}
                          </span>
                          <button
                            onClick={(e) => deleteSavedQuery(item.id, e)}
                            className="opacity-0 group-hover:opacity-100 p-1 hover:text-red-500 transition-opacity"
                          >
                            <X className="w-3 h-3" />
                          </button>
                        </div>
                        <code className="block truncate font-mono text-gray-400">
                          {item.sql.substring(0, 40)}{item.sql.length > 40 ? '...' : ''}
                        </code>
                      </div>
                    ))
                  )}
                </div>
              )}
            </div>
          </div>
        )}

        {/* Main Editor Area */}
        <div className="flex-1 flex flex-col gap-4 min-w-0">
          {/* SQL Editor Card */}
          <div className="flex flex-col bg-gray-800 rounded-lg border border-gray-700 overflow-hidden" style={{ minHeight: '400px' }}>
            {/* Toolbar */}
            <div className="flex items-center justify-between px-3 py-2 border-b border-gray-700 bg-gray-800 flex-shrink-0">
              <div className="flex items-center gap-2">
                <Database className="w-4 h-4 text-gray-500" />
                <span className="text-xs text-gray-400">power_db</span>
              </div>
              <div className="flex gap-1">
                <button 
                  className="p-1.5 hover:bg-gray-700 rounded text-gray-400 hover:text-gray-200" 
                  onClick={copyToClipboard}
                  title="Copy SQL"
                >
                  <Copy className="w-4 h-4" />
                </button>
                <button 
                  className="p-1.5 hover:bg-gray-700 rounded text-gray-400 hover:text-red-400" 
                  onClick={clearQuery}
                  title="Clear"
                >
                  <Trash2 className="w-4 h-4" />
                </button>
              </div>
            </div>

            {/* Editor Content */}
            <div className="flex flex-1 min-h-0">
              <div className="flex-1 relative">
                <textarea
                  ref={textareaRef}
                  value={query}
                  onChange={(e) => setQuery(e.target.value)}
                  onKeyDown={handleKeyDown}
                  className="w-full h-full bg-[#1e1e1e] text-gray-300 font-mono p-4 text-sm resize-none focus:outline-none leading-relaxed"
                  spellCheck={false}
                  placeholder="Enter your SQL query here...&#10;Press Ctrl+Enter to execute"
                  style={{ minHeight: '300px' }}
                />
              </div>

              {/* Parameters Panel */}
              {detectedParams.length > 0 && (
                <div className="w-56 bg-gray-900 border-l border-gray-700 p-3 overflow-y-auto flex-shrink-0">
                  <h3 className="text-xs font-bold text-gray-500 uppercase mb-3 flex items-center">
                    <Box className="w-3 h-3 mr-1" /> Parameters
                  </h3>
                  <div className="space-y-3">
                    {detectedParams.map(param => (
                      <div key={param}>
                        <label className="block text-xs text-blue-400 font-mono mb-1">
                          {'{{'}{param}{'}}'}
                        </label>
                        <input
                          type="text"
                          value={params[param] || ''}
                          onChange={(e) => setParams(prev => ({...prev, [param]: e.target.value}))}
                          className="w-full bg-gray-800 border border-gray-700 rounded px-2 py-1 text-xs text-gray-200 outline-none focus:border-blue-500"
                        />
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>

            {/* Bottom Toolbar */}
            <div className="px-3 py-2 border-t border-gray-700 bg-gray-800 flex justify-between items-center flex-shrink-0">
              <div className="flex gap-1.5 items-center">
                <span className="text-xs text-gray-500 flex items-center mr-2">
                  <LayoutTemplate className="w-3 h-3 mr-1" /> Templates:
                </span>
                {SAMPLE_TEMPLATES.map((template, i) => (
                  <button 
                    key={i} 
                    onClick={() => setQuery(template.sql)} 
                    className="text-[11px] bg-gray-700 hover:bg-gray-600 text-gray-300 px-2 py-1 rounded border border-gray-600 transition-colors"
                  >
                    {template.name}
                  </button>
                ))}
              </div>
              <div className="flex gap-2">
                <button 
                  onClick={handleExplain} 
                  className="flex items-center px-3 py-1.5 bg-gray-700 hover:bg-gray-600 text-gray-200 rounded text-sm font-medium transition border border-gray-600"
                >
                  <Gauge className="w-4 h-4 mr-1.5" />
                  Explain
                </button>
                <button 
                  onClick={handleExecute} 
                  disabled={executing} 
                  className="flex items-center px-4 py-1.5 bg-green-600 hover:bg-green-500 disabled:bg-green-800 text-white rounded text-sm font-medium transition shadow-md"
                >
                  {executing ? <Loader2 className="w-4 h-4 mr-1.5 animate-spin" /> : <Play className="w-4 h-4 mr-1.5 fill-current" />}
                  {executing ? 'Running...' : 'Run Query'}
                </button>
              </div>
            </div>
          </div>

          {/* Results Panel */}
          <div className="flex flex-col bg-gray-800 rounded-lg border border-gray-700 overflow-hidden" style={{ minHeight: '300px' }}>
            {/* Tabs */}
            <div className="flex border-b border-gray-700 bg-gray-800">
              <button
                onClick={() => setActiveTab('RESULTS')}
                className={`flex items-center gap-1.5 py-2 px-3 text-xs font-medium border-b-2 transition-colors ${
                  activeTab === 'RESULTS' 
                    ? 'border-green-500 text-green-400 bg-gray-800' 
                    : 'border-transparent text-gray-400 hover:text-gray-200'
                }`}
              >
                <Table2 className="w-3.5 h-3.5" />
                Results
                {result && result.rows > 0 && (
                  <span className="ml-1 text-[10px] bg-gray-700 px-1.5 py-0.5 rounded">
                    {result.rows}
                  </span>
                )}
              </button>
              <button
                onClick={() => setActiveTab('LOGS')}
                className={`flex items-center gap-1.5 py-2 px-3 text-xs font-medium border-b-2 transition-colors ${
                  activeTab === 'LOGS' 
                    ? 'border-blue-500 text-blue-400 bg-gray-800' 
                    : 'border-transparent text-gray-400 hover:text-gray-200'
                }`}
              >
                <Code2 className="w-3.5 h-3.5" />
                Execution Log
              </button>
              <button
                onClick={() => setActiveTab('EXPLAIN')}
                className={`flex items-center gap-1.5 py-2 px-3 text-xs font-medium border-b-2 transition-colors ${
                  activeTab === 'EXPLAIN' 
                    ? 'border-purple-500 text-purple-400 bg-gray-800' 
                    : 'border-transparent text-gray-400 hover:text-gray-200'
                }`}
              >
                <Gauge className="w-3.5 h-3.5" />
                Profiler
              </button>
              <button
                onClick={() => setActiveTab('MACROS')}
                className={`flex items-center gap-1.5 py-2 px-3 text-xs font-medium border-b-2 transition-colors ${
                  activeTab === 'MACROS' 
                    ? 'border-yellow-500 text-yellow-400 bg-gray-800' 
                    : 'border-transparent text-gray-400 hover:text-gray-200'
                }`}
              >
                <Wand2 className="w-3.5 h-3.5" />
                Macros
              </button>
            </div>

            {/* Tab Content */}
            <div className="flex-1 overflow-auto p-4" style={{ minHeight: '250px' }}>
              {/* RESULTS TAB */}
              {activeTab === 'RESULTS' && (
                <div className="h-full flex flex-col">
                  {result && result.rows > 0 && (
                    <div className="flex justify-between items-center px-3 py-1.5 text-xs border-b mb-2 bg-gray-800 border-gray-700 text-gray-400">
                      <span>{result.rows} rows returned</span>
                      <span>Time: {executionTime}ms</span>
                    </div>
                  )}
                  <QueryResultTable data={result || { columns: [], data: [], rows: 0 }} isDark={isDark} loading={executing} />
                </div>
              )}

              {/* LOGS TAB */}
              {activeTab === 'LOGS' && (
                <div className="font-mono text-xs space-y-1">
                  {logs.map((log, i) => (
                    <div key={i} className={`break-all ${log.includes('Native SQL') ? 'text-blue-400' : log.includes('ERROR') ? 'text-red-400' : 'text-green-400'}`}>
                      {log}
                    </div>
                  ))}
                </div>
              )}

              {/* EXPLAIN TAB */}
              {activeTab === 'EXPLAIN' && (
                <div>
                  {explainResult ? (
                    <div className="space-y-3">
                      <div className="flex justify-between items-center">
                        <h4 className="text-xs font-bold text-gray-500 uppercase">Query Execution Plan</h4>
                        <button
                          onClick={handleAiPlanAnalysis}
                          disabled={analyzingPlan}
                          className="text-[10px] flex items-center bg-purple-600 hover:bg-purple-500 text-white px-2 py-1 rounded"
                        >
                          {analyzingPlan ? <RefreshCw className="w-3 h-3 animate-spin mr-1"/> : <Lightbulb className="w-3 h-3 mr-1"/>}
                          AI Analyze
                        </button>
                      </div>

                      {aiExplain && (
                        <div className="p-2 bg-purple-900/20 border border-purple-500/30 rounded text-xs">
                          <div className="flex items-center text-purple-300 font-bold mb-1">
                            <Lightbulb className="w-3 h-3 mr-1"/> Optimization Suggestion
                          </div>
                          <p className="text-gray-300">{aiExplain}</p>
                        </div>
                      )}

                      <div className="space-y-2">
                        {renderExplainNode(explainResult)}
                      </div>
                    </div>
                  ) : (
                    <div className="flex flex-col items-center justify-center h-64 text-gray-500">
                      <Gauge className="w-8 h-8 mb-2 opacity-20"/>
                      <p className="text-xs text-center">Click "Explain" to visualize query performance.</p>
                    </div>
                  )}
                </div>
              )}

              {/* MACROS TAB */}
              {activeTab === 'MACROS' && (
                <div>
                  <h3 className="text-xs font-bold text-gray-500 uppercase mb-2">Available Macros</h3>
                  <div className="text-xs text-gray-400 space-y-2">
                    <div className="p-2 bg-gray-800/50 rounded border border-gray-700">
                      <span className="text-purple-400 font-mono block mb-0.5">$interval(1m)</span>
                      <span className="text-gray-500">Expands to: INTERVAL(1m) SLIDING(1m) FILL(PREV)</span>
                    </div>
                    <div className="p-2 bg-gray-800/50 rounded border border-gray-700">
                      <span className="text-purple-400 font-mono block mb-0.5">$last_24h</span>
                      <span className="text-gray-500">{'Expands to: WHERE ts >= NOW - 24h'}</span>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>

      {/* Save Query Dialog */}
      {showSaveDialog && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
          <div className="w-96 p-6 rounded-lg shadow-xl bg-gray-800 border border-gray-700">
            <h3 className="text-lg font-semibold mb-4 text-white">
              Save Query
            </h3>
            <input
              type="text"
              value={saveQueryName}
              onChange={(e) => setSaveQueryName(e.target.value)}
              placeholder="Enter query name..."
              className="w-full px-3 py-2 rounded border mb-4 bg-gray-700 border-gray-600 text-white placeholder-gray-400 focus:outline-none focus:border-blue-500"
              autoFocus
            />
            <div className="flex justify-end gap-2">
              <button
                onClick={() => setShowSaveDialog(false)}
                className="px-4 py-2 rounded text-sm text-gray-300 hover:text-white"
              >
                Cancel
              </button>
              <button
                onClick={handleSaveQuery}
                disabled={!saveQueryName.trim()}
                className="px-4 py-2 bg-blue-600 hover:bg-blue-500 disabled:bg-blue-800 text-white rounded text-sm font-medium"
              >
                Save
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default QueryWorkbench;
