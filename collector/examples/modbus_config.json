{
  "collector_id": "collector-001",
  "name": "Industrial Modbus Collector",
  "version": "1.0.0",
  "heartbeat_interval": 60,
  
  "auth": {
    "collector_id": "collector-001",
    "secret_key": "your-secret-key-here",
    "platform_endpoint": "https://your-platform.com:8088",
    "token_refresh_url": "/api/v1/auth/collector/refresh",
    "max_retries": 3,
    "retry_delay": 5,
    "tls": {
      "insecure_skip_verify": false,
      "min_version": "1.2",
      "max_version": "1.3",
      "handshake_timeout": 10
    },
    "security": {
      "key_store_path": "./keys",
      "master_key_path": "./keys/master.key",
      "auto_generate": true,
      "key_rotation_days": 90,
      "encrypt_secret_key": true
    }
  },
  
  "logger": {
    "level": "info",
    "format": "json",
    "output": "file",
    "file_path": "./logs/collector.log",
    "max_size": 100,
    "max_backups": 3,
    "max_age": 30
  },
  
  "buffer": {
    "max_size": 10000,
    "flush_interval": 30,
    "flush_batch_size": 1000
  },
  
  "storage": {
    "database_path": "./collector_cache.db",
    "max_cache_size": 1073741824,
    "retention_days": 7,
    "cleanup_interval": 3600,
    "max_retries": 3,
    "retry_delay": 5
  },
  
  "platform": {
    "base_url": "https://your-platform.com:8088",
    "data_upload_url": "/api/v1/data/batch",
    "config_sync_url": "/api/v1/collectors/%s/config",
    "heartbeat_url": "/api/v1/collectors/%s/heartbeat",
    "timeout": 30,
    "max_retries": 3,
    "retry_delay": 5,
    "enable_compression": true
  },
  
  "collection_tasks": [
    {
      "task_id": "plc_data_collection",
      "name": "PLC Data Collection via Modbus TCP",
      "protocol": "modbus_tcp",
      "enabled": true,
      "schedule": {
        "interval": 5,
        "unit": "seconds"
      },
      "connection": {
        "host": "192.168.1.100",
        "port": 502,
        "slave_id": 1,
        "timeout": 5000,
        "retry_count": 3,
        "retry_delay": 100
      },
      "data_points": [
        {
          "name": "temperature",
          "address": "40001",
          "data_type": "float32",
          "scale": 0.1,
          "offset": 0,
          "unit": "°C",
          "tags": {
            "location": "workshop_a",
            "equipment": "furnace_01"
          }
        },
        {
          "name": "pressure",
          "address": "40002",
          "data_type": "int16",
          "scale": 1.0,
          "offset": 0,
          "unit": "Pa",
          "tags": {
            "location": "workshop_a",
            "equipment": "compressor_01"
          }
        },
        {
          "name": "motor_status",
          "address": "coil:1",
          "data_type": "bool",
          "scale": 0,
          "offset": 0,
          "unit": "",
          "tags": {
            "location": "workshop_a",
            "equipment": "motor_01",
            "type": "status"
          }
        },
        {
          "name": "flow_rate",
          "address": "holding:100",
          "data_type": "float32",
          "scale": 0.01,
          "offset": 0,
          "unit": "L/min",
          "tags": {
            "location": "workshop_a",
            "equipment": "pump_01"
          }
        }
      ],
      "target": {
        "database": "industrial_data",
        "super_table": "modbus_metrics",
        "tags": {
          "collector_id": "collector-001",
          "protocol": "modbus_tcp",
          "device_type": "plc",
          "location": "factory_a"
        }
      }
    },
    {
      "task_id": "sensor_data_collection",
      "name": "Sensor Data Collection via Modbus RTU",
      "protocol": "modbus_rtu",
      "enabled": true,
      "schedule": {
        "interval": 10,
        "unit": "seconds"
      },
      "connection": {
        "serial_port": "/dev/ttyUSB0",
        "baud_rate": 9600,
        "data_bits": 8,
        "stop_bits": 1,
        "parity": "N",
        "slave_id": 2,
        "timeout": 5000,
        "retry_count": 3,
        "retry_delay": 100
      },
      "data_points": [
        {
          "name": "humidity",
          "address": "30001",
          "data_type": "float32",
          "scale": 0.01,
          "offset": 0,
          "unit": "%",
          "tags": {
            "location": "warehouse",
            "sensor_type": "dht22"
          }
        },
        {
          "name": "ambient_temperature",
          "address": "30002",
          "data_type": "float32",
          "scale": 0.1,
          "offset": -40,
          "unit": "°C",
          "tags": {
            "location": "warehouse",
            "sensor_type": "dht22"
          }
        },
        {
          "name": "door_status",
          "address": "discrete:1",
          "data_type": "bool",
          "scale": 0,
          "offset": 0,
          "unit": "",
          "tags": {
            "location": "warehouse",
            "equipment": "main_door",
            "type": "status"
          }
        }
      ],
      "target": {
        "database": "industrial_data",
        "super_table": "sensor_metrics",
        "tags": {
          "collector_id": "collector-001",
          "protocol": "modbus_rtu",
          "device_type": "sensor",
          "location": "factory_a"
        }
      }
    }
  ]
}