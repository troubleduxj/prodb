# Configuration for the ProDB Collector

# Platform API Endpoint
# The URL of the platform's backend API where the collected data will be sent.
PLATFORM_API_ENDPOINT=http://localhost:8080/api/v1/data

# Local Cache Database Path
# The file path for the local SQLite database used for store-and-forward.
# If not set, defaults to ./collector_cache.db
LOCAL_DB_PATH=./collector_cache.db
